# 로컬 개발 전용 설정. .env-develop로 복사한 뒤 실제 값을 입력한다.
HOLIDAY_API_KEY=
# CS 시스템(cs-board) 신규 CS 연동 (예: CS_API_URL=http://localhost:1031, CS_API_KEY는 cs-board의 CS_EXTERNAL_API_KEY와 같은 값)
CS_API_URL=
CS_API_KEY=
CS_WEB_URL=
# 구글 클라우드 OAuth 클라이언트 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 첨부·양식 파일 저장 폴더 (비우면 backend 실행 위치의 ./storage)
# STORAGE_PATH=./storage
