# 로컬 개발용 기본값. 운영에서는 .env를 새로 만들고 아래 비밀값을 반드시 바꾼다.
DB_URL=jdbc:postgresql://localhost:5432/portal
DB_USERNAME=portal
DB_PASSWORD=portal
STORAGE_PATH=./storage
# 개발용 백엔드 업로드 상한 (운영 compose는 50MB 고정)
MAX_UPLOAD_SIZE=50MB
INTERNAL_API_TOKEN=dev-internal-token
BACKEND_URL=http://localhost:8080
COLLAB_PORT=1234
# 공공데이터포털 한국천문연구원 특일 정보의 디코딩 인증키
HOLIDAY_API_KEY=

# 구글 클라우드 OAuth 클라이언트 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=example.com
ALLOWED_HOSTED_DOMAINS=example.org,example.com

# 운영(docker compose) 전용: 호스트에 노출할 포트
PORTAL_PORT=80
