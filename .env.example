# 로컬 개발용 기본값. 운영에서는 .env를 새로 만들고 아래 비밀값을 반드시 바꾼다.
DB_URL=jdbc:postgresql://localhost:5432/portal
DB_USERNAME=portal
DB_PASSWORD=portal
STORAGE_PATH=./storage
# 개발용 백엔드 업로드 상한 (운영 compose는 50MB 고정)
MAX_UPLOAD_SIZE=50MB
INTERNAL_API_TOKEN=dev-internal-token
BACKEND_URL=http://localhost:8080
COLLAB_PORT=1234

# 운영(docker compose) 전용: 호스트에 노출할 포트
PORTAL_PORT=80
